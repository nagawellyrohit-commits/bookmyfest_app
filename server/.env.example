PORT=5001
DATABASE_URL="postgresql://user:pass@localhost:5432/dbname"
JWT_SECRET=your_jwt_secret_key
UPLOAD_STORAGE=local
UPLOAD_PATH=uploads

# SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="Your App <user@example.com>"

# WhatsApp API Provider Details
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=your_verify_token

# OpenRouter Configurations
OPENROUTER_API_KEY=your_key
OPENROUTER_MODEL=google/gemini-2.5-flash

# Support & Admin Notification Settings
SUPPORT_NOTIFICATION_PHONE=919876543210

# Backup Configuration Settings
BACKUP_BASE_DIR=/var/www/bookmyfest_backups
RESTIC_PASSWORD_FILE=/var/www/bookmyfest_backups/restic-password
BACKUP_ADMIN_EMAIL=support@bookmyfest.co
