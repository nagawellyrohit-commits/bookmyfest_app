datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  student
  coordinator
  faculty_admin
  super_admin
  guest
}

enum PaymentStatus {
  pending
  completed
  failed
  free_event
}

model College {
  id         String   @id @default(uuid())
  name       String
  domain     String?  @unique
  createdAt  DateTime @default(now()) @map("created_at")
  users      User[]
  events     Event[]

  @@map("colleges")
}

model User {
  id            String         @id @default(uuid())
  collegeId     String?        @map("college_id")
  college       College?       @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  fullName      String         @map("full_name")
  email         String         @unique
  passwordHash  String         @map("password_hash")
  phone         String?
  whatsappEnabled Boolean        @default(true) @map("whatsapp_enabled")
  role          Role           @default(student)
  department    String?
  idProofUrl    String?        @map("id_proof_url")
  isFinalYear   Boolean        @default(false) @map("is_final_year")
  isVerified    Boolean        @default(false) @map("is_verified")
  studentId     String?        @map("student_id")
  isParent      Boolean        @default(false) @map("is_parent")
  parentStudentName    String?  @map("parent_student_name")
  parentStudentCollege String? @map("parent_student_college")
  isPendingDeletion Boolean      @default(false) @map("is_pending_deletion")
  createdAt     DateTime       @default(now()) @map("created_at")
  jobProfile    JobProfile?
  createdEvents Event[]        @relation("CreatedEvents")
  registrations Registration[]
  attendance    Attendance[]   @relation("AttendedBy")
  verifiedScans Attendance[]   @relation("VerifiedScans")
  auditLogs     AuditLog[]

  @@map("users")
}

model JobProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeUrl    String   @map("resume_url")
  businessName String?  @map("business_name")
  description  String?
  contactPhone String?  @map("contact_phone")
  websiteUrl   String?  @map("website_url")
  instagramUrl String?  @map("instagram_url")
  linkedinUrl  String?  @map("linkedin_url")
  branch       String?
  passingYear  Int?     @map("passing_year")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("job_profiles")
}

model Event {
  id                   String         @id @default(uuid())
  collegeId            String         @map("college_id")
  college              College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdBy            String         @map("created_by")
  creator              User           @relation("CreatedEvents", fields: [createdBy], references: [id], onDelete: Cascade)
  title                String
  description          String?
  eventDate            DateTime       @map("event_date")
  registrationDeadline DateTime       @map("registration_deadline")
  isPaid               Boolean        @default(false) @map("is_paid")
  entryFee             Decimal        @default(0.00) @map("entry_fee") @db.Decimal(10, 2)
  upiId                String?        @map("upi_id")
  qrAttendanceCode     String         @unique @map("qr_attendance_code")
  certificateTemplate  Json?          @map("certificate_template")
  branch               String         @default("Open")
  category             String         @default("Other")
  brochureUrl          String?        @map("brochure_url")
  brochurePages        Int            @default(0) @map("brochure_pages")
  posterUrl1           String?        @map("poster_url_1")
  posterUrl2           String?        @map("poster_url_2")
  posterUrl3           String?        @map("poster_url_3")
  posterUrl4           String?        @map("poster_url_4")
  whatsAppGroupLink    String?        @map("whatsapp_group_link")
  eventType            String         @default("individual") @map("event_type")
  minMembers           Int            @default(1) @map("min_members")
  maxMembers           Int            @default(1) @map("max_members")
  isApproved           Boolean        @default(true) @map("is_approved")
  isPendingDeletion    Boolean        @default(false) @map("is_pending_deletion")
  rejectionReason      String?        @map("rejection_reason")
  pendingUpdates       Json?          @map("pending_updates")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  registrations        Registration[]
  attendance           Attendance[]

  @@map("events")
}

model Registration {
  id               String        @id @default(uuid())
  eventId          String        @map("event_id")
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String        @map("user_id")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationType String        @default("individual") @map("registration_type")
  paymentStatus    PaymentStatus @default(free_event) @map("payment_status")
  paymentReference String?       @map("payment_reference")
  registrationDate DateTime      @default(now()) @map("registration_date")

  @@map("registrations")
}

model Attendance {
  id         String   @id @default(uuid())
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation("AttendedBy", fields: [userId], references: [id], onDelete: Cascade)
  markedAt   DateTime @default(now()) @map("marked_at")
  verifiedBy String?  @map("verified_by")
  verifier   User?    @relation("VerifiedScans", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@map("attendance")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  targetTable String   @map("target_table")
  targetId    String   @map("target_id")
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}

model Sponsor {
  id        String   @id @default(uuid())
  name      String
  subtitle  String?
  logoUrl   String   @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sponsors")
}
